---
import { nav, site } from '../data/site';
---

<footer class="border-t border-white/10 bg-ink text-white">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <p class="font-display text-3xl tracking-tight">Christopher Noblett</p>
      <p class="mt-3 max-w-sm text-white/70">
        Custom websites for dental clinics and healthcare practices. Based in Dublin.
      </p>
      <a href="/contact" class="btn btn-light mt-8">Get a free quote</a>
    </div>

    <div class="md:col-span-3">
      <p class="mb-4 text-sm font-semibold text-white/50">Pages</p>
      <ul class="space-y-2.5 text-white/85">
        {nav.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="mb-4 text-sm font-semibold text-white/50">Contact</p>
      <ul class="space-y-2.5 text-white/85">
        <li><a href={site.phoneHref} class="hover:text-white">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-words hover:text-white">{site.email}</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-white">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-sm text-white/50 sm:flex-row sm:justify-between">
      <p>&copy; {new Date().getFullYear()} Christopher Noblett</p>
      <p>Dublin, Ireland</p>
    </div>
  </div>
</footer>
