---
interface Props {
  title: string;
  intro: string;
}
const { title, intro } = Astro.props;
---

<section class="border-b border-line pb-14 pt-14 md:pb-20 md:pt-24">
  <div class="wrap grid items-end gap-8 lg:grid-cols-12">
    <h1 class="h-display lg:col-span-7">{title}</h1>
    <div class="lg:col-span-5 lg:pb-2">
      <p class="lede">{intro}</p>
      <slot />
    </div>
  </div>
</section>
