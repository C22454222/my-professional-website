---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s talk about your clinic’s website',
  text = 'Tell me a bit about your practice and I’ll come back with a fixed quote, usually within a day. No obligation.',
} = Astro.props;
---

<section class="section bg-ink text-white">
  <div class="wrap grid items-end gap-8 lg:grid-cols-12">
    <h2 class="h-section !text-white lg:col-span-7">{title}</h2>
    <div class="lg:col-span-5">
      <p class="text-lg leading-relaxed text-white/75">{text}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-light">Get a free quote</a>
        <a href="/#free-review" class="btn border border-white/30 text-white hover:border-white/70">Review my current site</a>
      </div>
    </div>
  </div>
</section>
