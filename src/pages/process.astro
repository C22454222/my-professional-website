---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Steps from '../components/Steps.astro';
import CallToAction from '../components/CallToAction.astro';

const needs = [
  { title: 'Your logo', text: 'Any format. If you don’t have one, I can set up a clean text logo to start with.' },
  { title: 'Photos', text: 'The clinic, the team, the waiting room. Phone photos are fine. I’ll tell you which ones work.' },
  { title: 'Your treatments', text: 'A list of what you offer, and fees if you publish them.' },
  { title: 'Practical details', text: 'Address, opening hours, phone number, and the booking system you use, if any.' },
];
---

<Layout
  title="Process"
  description="How a clinic website project works: a free call, a homepage design, the full build and launch. Most simple sites are live within a week."
>
  <PageHeader
    title="How a project works"
    intro="No jargon and no long contracts. A short call, a design you can see on your own phone, and a site that’s live fast."
  />

  <section class="section pt-14 md:pt-20">
    <div class="wrap">
      <Steps detailed />
      <p class="mt-5 text-[0.95rem] text-slate">Times are for a typical simple site. Larger sites with treatment pages and booking take two to three weeks in total.</p>
    </div>
  </section>

  <section class="section border-t border-line bg-white">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="h-section">What I need from you</h2>
        <p class="mt-5 text-slate">Not much. If any of this is missing, we’ll work around it. I can also help write the text from our first call.</p>
      </div>
      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {needs.map((n) => (
          <div class="border-t-2 border-ink pt-5">
            <h3 class="text-[1.5rem] leading-tight">{n.title}</h3>
            <p class="mt-3 leading-relaxed text-slate">{n.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction title="Ready when you are" />
</Layout>
