---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Simple Website',
    price: '€250',
    desc: '3-5 pages, custom design, mobile responsive. Perfect for getting a professional presence online fast.',
  },
  {
    name: 'Custom Business Website',
    price: '€400 - €600',
    desc: 'More pages, animations, forms and integrations, plus SEO so people can actually find you.',
  },
  {
    name: 'Maintenance & Hosting',
    price: '€20 - €50 / month',
    desc: 'Hosting, backups, updates, small changes and monitoring, so your site keeps running smoothly.',
  },
];
---

<Layout title="Services">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">Pricing</p>
    <h1 class="text-4xl mb-6">Services</h1>
    <p class="text-white/85">
      Simple, transparent pricing. A completely customised professional website, ready within a week.
    </p>
  </section>

  <section class="bg-white text-brand-500">
    <div class="max-w-5xl mx-auto px-6 py-24">
      <div class="grid md:grid-cols-3 gap-6">
        {services.map((s) => (
          <div class="border border-brand-500/25 rounded-2xl p-8">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-xl">{s.name}</h3>
              <span class="text-brand-500/70 text-sm">{s.price}</span>
            </div>
            <p class="text-brand-500/85 text-sm leading-relaxed mb-4">{s.desc}</p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-brand-500/70">Free, no-obligation quote</span>
              <a href="/contact" class="text-sm underline hover:opacity-70 transition">
                Get in touch
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
