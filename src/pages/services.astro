---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import CallToAction from '../components/CallToAction.astro';
import { faqs } from '../data/site';

const included = [
  { title: 'Designed for your clinic', text: 'No templates. The layout, colours and photos are chosen around your practice and your patients.' },
  { title: 'Built for phones first', text: 'Big, readable text, a menu that works with one thumb, and tap-to-call on every page.' },
  { title: 'Fast to load', text: 'Hand-built sites with no page-builder bloat, so pages open almost instantly, even on mobile data.' },
  { title: 'Easy to book from', text: 'A clear booking button in the same place on every page, linked to the system you already use.' },
  { title: 'Found on Google', text: 'Proper page titles, treatment pages, and your clinic details set up so search engines understand them.' },
  { title: 'Secure and private', text: 'HTTPS on every page, and contact forms that send straight to your inbox without storing patient data on the site.' },
  { title: 'Yours to keep', text: 'You own the domain, the design and the code. If you ever move on, everything comes with you.' },
  { title: 'Support after launch', text: 'I don’t disappear once it’s live. If something isn’t right after launch, I fix it.' },
];
---

<Layout
  title="Services and Pricing"
  description="Website design for dental clinics in Dublin. Simple sites from €250, custom clinic websites from €400, hosting and care from €20 a month. Fixed quotes, no hidden extras."
>
  <PageHeader
    title="Services and pricing"
    intro="Three ways to work together. Every price is fixed and agreed before I start, and every site is built from scratch for your clinic."
  />

  <section class="section pt-14 md:pt-20">
    <div class="wrap">
      <Pricing />
    </div>
  </section>

  <section class="section border-t border-line bg-white">
    <div class="wrap">
      <h2 class="h-section max-w-2xl">Included in every website</h2>
      <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {included.map((i) => (
          <div class="border-t border-line pt-5">
            <h3 class="text-[1.35rem] leading-tight">{i.title}</h3>
            <p class="mt-2.5 text-[0.975rem] leading-relaxed text-slate">{i.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="h-section">Common questions</h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
