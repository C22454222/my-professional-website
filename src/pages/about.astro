---
import Layout from '../layouts/Layout.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';

const facts = [
  { label: 'Education', value: 'BSc Computer Science, First Class Honours, TU Dublin' },
  { label: 'Experience', value: 'IT operations at EirGrid, software engineering at Alizé' },
  { label: 'Based in', value: 'Dublin, working with clinics anywhere in Ireland' },
  { label: 'Outside work', value: 'Running, usually training for the next marathon' },
];
---

<Layout
  title="About"
  description="Christopher Noblett is a Dublin web developer with a first class honours Computer Science degree, building custom websites for dental clinics."
>
  <section class="border-b border-line pb-16 pt-14 md:pb-24 md:pt-24">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <img
          src="/images/headshot.jpg"
          alt="Christopher Noblett"
          width="400"
          height="400"
          class="aspect-square w-56 rounded-3xl object-cover sm:w-64 lg:w-full"
        />
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <h1 class="h-display">Hi, I’m Christopher.</h1>
        <div class="mt-8 max-w-prose space-y-5 text-lg leading-relaxed text-slate">
          <p>
            I’m a web developer in Dublin, and I build websites for dental clinics and other healthcare practices.
          </p>
          <p>
            I started freelancing because I wanted to help clinics get the kind of website that’s usually reserved
            for practices with agency budgets. Too many good local clinics are let down by sites that are slow, hard
            to use on a phone, or years out of date.
          </p>
          <p>
            Before freelancing I worked in IT operations at EirGrid, keeping production systems running, and as a
            software engineer at Alizé. That background shapes how I build. I care about the parts patients never
            see: speed, security, and a site that stays up.
          </p>
          <p>
            When we work together, you deal with me directly. I’ll answer your emails, design your site, build it,
            and look after it afterwards if you want me to.
          </p>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Get in touch</a>
          <a href="/christopher-noblett-cv.pdf" download class="btn btn-secondary">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
            Download CV
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="btn btn-secondary">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((f) => (
          <div class="border-t-2 border-ink pt-5">
            <dt class="text-sm text-slate">{f.label}</dt>
            <dd class="mt-2 font-display text-[1.35rem] leading-snug">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CallToAction />
</Layout>
