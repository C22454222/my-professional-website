---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" noindex>
  <section class="pb-28 pt-20 md:pt-32">
    <div class="wrap max-w-3xl">
      <h1 class="h-display">This page doesn’t exist.</h1>
      <p class="lede mt-6">The link may be old or mistyped. Everything on the site is one click from the home page.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <a href="/contact" class="btn btn-secondary">Contact me</a>
      </div>
    </div>
  </section>
</Layout>
