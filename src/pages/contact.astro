---
import Layout from '../layouts/Layout.astro';

const WEB3FORMS_ACCESS_KEY = "b1dec726-cbf5-4a4b-a49c-82e2251eb72e";
---
<Layout title="Contact">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">Contact</p>
    <h1 class="text-4xl mb-6">Get In Touch</h1>
    <p class="text-white/85">Questions, bookings, or just want to say hi, reach out any of these ways.</p>
  </section>

  <section class="bg-white text-brand-500">
    <div class="max-w-4xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10">
      <div class="space-y-4">
        <a href="mailto:christophernoblett.dev@gmail.com" class="block border border-brand-500/25 rounded-2xl p-6 hover:bg-brand-500/5 transition">
          <p class="text-brand-500/70 text-xs uppercase tracking-wide mb-1 flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
            Email
          </p>
          <p class="text-brand-500">christophernoblett.dev@gmail.com</p>
        </a>
        <a href="https://www.linkedin.com/in/christopher-noblett/" target="_blank" rel="noopener" class="block border border-brand-500/25 rounded-2xl p-6 hover:bg-brand-500/5 transition">
          <p class="text-brand-500/70 text-xs uppercase tracking-wide mb-1 flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.55 4.78 5.87V21h-4v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21h-4V9Z"/></svg>
            LinkedIn
          </p>
          <p class="text-brand-500">Christopher Noblett</p>
        </a>
      </div>

      <div>
        <form id="contact-form" class="space-y-4">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="New message from website contact form" />
          <input type="hidden" name="from_name" value="Christopher's Website" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <input type="text" name="name" placeholder="Your name" required
            class="w-full border border-brand-500/25 rounded-lg px-4 py-2 text-brand-500 placeholder-brand-500/40" />
          <input type="email" name="email" placeholder="Your email" required
            class="w-full border border-brand-500/25 rounded-lg px-4 py-2 text-brand-500 placeholder-brand-500/40" />
          <textarea name="message" placeholder="Your message" rows="6" required
            class="w-full border border-brand-500/25 rounded-lg px-4 py-2 text-brand-500 placeholder-brand-500/40"></textarea>
          <button type="submit"
            class="w-full bg-brand-500 text-white py-2 rounded-full hover:bg-brand-500/90 transition font-medium">
            Send Message
          </button>
          <p id="form-status" role="status" class="text-sm text-center min-h-[1.2rem]"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    status.textContent = 'Sending…';

    const formData = new FormData(form);
    const object: Record<string, string> = {};
    formData.forEach((value, key) => { object[key] = value.toString(); });
    const json = JSON.stringify(object);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: json,
      });
      const result = await res.json();

      if (result.success) {
        status.textContent = 'Thanks! Your message has been sent.';
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try again.';
        console.error(result);
      }
    } catch (err) {
      status.textContent = 'Network error. Please try again.';
      console.error(err);
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
