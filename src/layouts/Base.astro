---
// Bare HTML shell: fonts, meta tags, structured data. Used by Layout.astro and the concept demo.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const {
  title,
  description = 'Custom, modern websites for dental clinics in Dublin. Fast on phones, easy to book from, fixed prices from €250. Built by Christopher Noblett.',
  noindex = false,
  image = '/og.png',
} = Astro.props;

const fullTitle = title ? `${title} | Christopher Noblett` : 'Websites for Dental Clinics in Dublin | Christopher Noblett';
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Christopher Noblett Web Design',
  url: site.url,
  image: ogImage,
  email: site.email,
  telephone: site.phone,
  description: 'Custom websites for dental clinics and healthcare practices in Dublin.',
  areaServed: [
    { '@type': 'City', name: 'Dublin' },
    { '@type': 'Country', name: 'Ireland' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Dublin', addressCountry: 'IE' },
  priceRange: '€250 - €600',
  founder: { '@type': 'Person', name: site.name, sameAs: [site.linkedin] },
  sameAs: [site.linkedin],
};
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F6F9FA" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Christopher Noblett" />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
